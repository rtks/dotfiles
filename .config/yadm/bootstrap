#!/bin/bash

export -n GIT_DIR
export -n GIT_WORK_TREE

msg() {
  if [ "$1" = "-n" ]; then
    printf "\e[1m$2\e[m"
  else
    printf "\e[1m$1\e[m\n"
  fi
}

# アーカイブ($1)から指定ファイル($2)を展開する。zip は unzip、無ければ Windows 標準の tar.exe(bsdtar)を使う
extract() {
  case "$1" in
    *.zip)
      if command -v unzip >/dev/null 2>&1; then
        unzip -oq "$1" "$2"
      else
        "$(cygpath -u "$SYSTEMROOT")/System32/tar.exe" -xf "$1" "$2"
      fi
      ;;
    *)
      tar -xzf "$1" "$2"
      ;;
  esac
}

getc() {
  local save_state
  save_state="$(/bin/stty -g)"
  /bin/stty raw -echo
  IFS='' read -r -n 1 -d '' "$@"
  /bin/stty "${save_state}"
}

# Check dependencies
deps=""
if ! command -v curl >/dev/null 2>&1; then
  deps=$deps" curl"
fi
if ! command -v git >/dev/null 2>&1; then
  deps=$deps" git"
fi
if ! command -v yadm >/dev/null 2>&1; then
  deps=$deps" yadm"
fi
yadm=yadm
if [ -n "$deps" ]; then
  msg "The following packages are required to continue:"
  echo $deps

  # Check package manager
  if [ "$OS" = "Darwin" ]; then
    pkgmgr="brew install"
    if ! command -v brew >/dev/null 2>&1; then
      pkgmgr='/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'"; $pkgmgr"
    fi
  else
    if [ $(id -u) -ne 0 ]; then
      sudo="sudo -E "
    else
      sudo=""
    fi
    if command -v apt-get >/dev/null 2>&1; then
      pkgmgr="${sudo}apt-get update; ${sudo}apt-get -y install"
    elif command -v apk >/dev/null 2>&1; then
      pkgmgr="${sudo}apk add --no-cache"
    elif command -v dnf >/dev/null 2>&1; then
      pkgmgr="${sudo}dnf install -y"
    else
      pkgmgr=""
    fi
  fi

  if [ -n "$pkgmgr" ]; then
    msg "1. Install the packages with:"
    cmd[1]="$pkgmgr$deps"
    yadm[1]=yadm
    keys="1"
    printf "${cmd[1]}\n"
  else
    if [ "$deps" != " yadm" ]; then
      exit 1
    fi
    msg "1. Install yadm in:"
    echo "~/.local/bin/"
    cmd[1]="curl -fsSL https://github.com/TheLocehiliosan/yadm/raw/master/yadm >$HOME/.local/bin/yadm; chmod +x $HOME/.local/bin/yadm"
    yadm[1]=$HOME/.local/bin/yadm
  fi
  if [[ "$deps" =~ " yadm" ]]; then
    if [ "$deps" = " yadm" ]; then
      msg "2. Use yadm remotely."
      cmd[2]=
    else
      msg "2. Install the minimum packages and use yadm remotely with:"
      cmd[2]="$pkgmgr${deps/ yadm/}"
      printf "${cmd[2]}\n"
    fi
    yadm[2]="curl -fsSL https://github.com/TheLocehiliosan/yadm/raw/master/yadm | bash -s --"
    keys="1 or 2"
  fi
  msg -n "Press $keys to continue with the selected option, or any other key to abort: "
  getc c
  echo
  [ "$c" != 1 -a "$c" != 2 ] && exit 1
  [ -z "${cmd[$c]}" -a -z "${yadm[$c]}" ] && exit 1
  msg "Installing packages"
  eval ${cmd[$c]}
  yadm="${yadm[$c]}"
  # Check dependencies
  deps=""
  if ! command -v curl >/dev/null 2>&1; then
    deps=$deps" curl"
  fi
  if ! command -v git >/dev/null 2>&1; then
    deps=$deps" git"
  fi
  if [ "$yadm" = "yadm" ] && ! command -v yadm >/dev/null 2>&1; then
    deps=$deps" yadm"
  fi
  if [ -n "$deps" ]; then
    msg "Failed to install$deps"
    exit 1
  fi
fi

if [ ! -d ~/.local/share/yadm/repo.git ]; then
  # Clone repository
  msg "Cloning repository"
  eval $yadm' clone --no-bootstrap "https://github.com/rtks/dotfiles.git"'
  eval $yadm' restore'
fi

# Bootstrap fish
if command -v fish >/dev/null 2>&1; then
  msg "Bootstraping fish"
  fish -c 'set_color_custom; set -U fish_greeting ""; fish_update_completions'

  # Install fisher
  if [ ! -f ~/.config/fish/functions/fisher.fish ]; then
    msg "Installing fisher"
    fish -l -c "curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher update"
  else
    msg "Bootstraping fisher"
    fish -l -c "fisher update"
  fi
else
  msg "fish not found. Skip bootstrap."
fi

# Bootstrap starship
if command -v starship &>/dev/null; then
  [ -f $HOME/.local/bin/starship ]
else
  command -v zsh &>/dev/null || command -v fish &>/dev/null
fi && {
  msg "Bootstraping starship"
  mkdir -p $HOME/.local/bin
  curl -fsSL https://starship.rs/install.sh | sh /dev/stdin -f -b $HOME/.local/bin | awk '/complete the installation/{exit}1'
}

# Bootstrap jj-starship
if command -v jj-starship &>/dev/null; then
  [ -f $HOME/.local/bin/jj-starship ] || [ -f $HOME/.local/bin/jj-starship.exe ]
else
  command -v jj &>/dev/null
fi && {
  msg "Bootstraping jj-starship"
  case "$(uname -s)" in
    Darwin)
      # Rosetta 上の shell では uname -m が x86_64 を返すため、CPU を直接調べる
      if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then
        target=aarch64-apple-darwin
      else
        target=x86_64-apple-darwin
      fi
      ;;
    Linux)
      case "$(uname -m)" in
        aarch64|arm64) target=aarch64-unknown-linux-musl ;;
        *) target=x86_64-unknown-linux-musl ;;
      esac
      ;;
    MSYS*|MINGW*|CYGWIN*)
      # MSYS ではなくネイティブの Windows 版を使う
      case "$(uname -m)" in
        aarch64|arm64) target=aarch64-pc-windows-msvc ;;
        *) target=x86_64-pc-windows-msvc ;;
      esac
      ;;
    *)
      target=
      ;;
  esac
  if [ -n "$target" ]; then
    case "$target" in
      *-windows-*) bin=jj-starship.exe; archive=jj-starship-$target.zip ;;
      *) bin=jj-starship; archive=jj-starship-$target.tar.gz ;;
    esac
    tmp=$(mktemp -d)
    if command -v shasum &>/dev/null; then
      sha256="shasum -a 256 -c -s"
    else
      sha256="sha256sum -c"
    fi
    # 実行中の Mach-O を上書きすると macOS が強制終了するため、展開したファイルを mv で置き換える
    (
      cd "$tmp" &&
        curl -fsSLO https://github.com/dmmulroy/jj-starship/releases/latest/download/$archive &&
        curl -fsSL https://github.com/dmmulroy/jj-starship/releases/latest/download/checksums-sha256.txt | grep " $archive\$" | $sha256 - >/dev/null &&
        extract $archive $bin &&
        chmod 755 $bin &&
        mkdir -p $HOME/.local/bin &&
        mv -f $bin $HOME/.local/bin/$bin
    ) && $HOME/.local/bin/$bin version | head -n 1 || msg "Failed to install jj-starship"
    rm -rf "$tmp"
  else
    msg "jj-starship is not available on $(uname -s). Skip bootstrap."
  fi
}

# Bootstrap tij
if command -v tij &>/dev/null; then
  [ -f $HOME/.local/bin/tij ] || [ -f $HOME/.local/bin/tij.exe ]
else
  command -v jj &>/dev/null
fi && {
  msg "Bootstraping tij"
  case "$(uname -s)" in
    Darwin)
      # Rosetta 上の shell では uname -m が x86_64 を返すため、CPU を直接調べる
      if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then
        target=aarch64-apple-darwin
      else
        target=x86_64-apple-darwin
      fi
      ;;
    Linux)
      case "$(uname -m)" in
        x86_64) target=x86_64-unknown-linux-gnu ;;
        *) target= ;;
      esac
      ;;
    MSYS*|MINGW*|CYGWIN*)
      # MSYS ではなくネイティブの Windows 版を使う
      case "$(uname -m)" in
        x86_64) target=x86_64-pc-windows-msvc ;;
        *) target= ;;
      esac
      ;;
    *)
      target=
      ;;
  esac
  if [ -n "$target" ]; then
    case "$target" in
      *-windows-*) bin=tij.exe; archive=tij-$target.zip ;;
      *) bin=tij; archive=tij-$target.tar.gz ;;
    esac
    tmp=$(mktemp -d)
    if command -v shasum &>/dev/null; then
      sha256="shasum -a 256 -c -s"
    else
      sha256="sha256sum -c"
    fi
    # チェックサムファイルが無いため、Releases API のアセットごとの digest で照合する
    # 実行中の Mach-O を上書きすると macOS が強制終了するため、展開したファイルを mv で置き換える
    (
      cd "$tmp" &&
        curl -fsSLO https://github.com/nakamura-shuta/tij/releases/latest/download/$archive &&
        digest=$(curl -fsSL https://api.github.com/repos/nakamura-shuta/tij/releases/latest |
          awk -v n="\"$archive\"," '$1 == "\"name\":" && $2 == n { f = 1 } f && $1 == "\"digest\":" { gsub(/[",]|sha256:/, "", $2); print $2; exit }') &&
        [ -n "$digest" ] &&
        echo "$digest  $archive" | $sha256 - >/dev/null &&
        extract $archive $bin &&
        chmod 755 $bin &&
        mkdir -p $HOME/.local/bin &&
        mv -f $bin $HOME/.local/bin/$bin
    ) && $HOME/.local/bin/$bin --version | head -n 1 || msg "Failed to install tij"
    rm -rf "$tmp"
  else
    msg "tij is not available on $(uname -s) $(uname -m). Skip bootstrap."
  fi
}

# Bootstrap tmux
if command -v tmux >/dev/null 2>&1; then
  if [ ! -f ~/.tmux/plugins/tpm/tpm ]; then
    msg "Installing Tmux Plugin Manager"
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
  fi
  msg "Bootstraping Tmux Plugin Manager"
  ~/.tmux/plugins/tpm/scripts/install_plugins.sh
else
  msg "tmux not found. Skip bootstrap."
fi

# Bootstrap neovim or vim
if command -v nvim >/dev/null 2>&1; then
  # Install vim-plug
  vimplug="${XDG_DATA_HOME:-$HOME/.local/share}"/nvim/site/autoload/plug.vim
  if [ ! -f "$vimplug" ]; then
    msg "Installing vim-plug"
    curl -fLo "$vimplug" --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
  fi
  msg "Bootstraping vim-plug"
  nvim --headless +'PlugInstall --sync' +qa
elif command -v vim >/dev/null 2>&1; then
  ln -sf .config/nvim/init.vim ~/.vimrc
  # Install vim-plug
  vimplug=~/.vim/autoload/plug.vim
  if [ ! -f "$vimplug" ]; then
    msg "Installing vim-plug"
    curl -fLo "$vimplug" --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
  fi
  msg "Bootstraping vim-plug"
  vim +'PlugInstall --sync' +qa
else
  msg "nvim and vim not found. Skip bootstrap."
fi

# Bootstrap tig
mkdir -p ~/.local/share/tig/
